{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "title": "DATAVORA INDONESIA",
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Deep Navy Blue (Primary)",
          "slug": "primary",
          "color": "#102A43"
        },
        {
          "name": "Royal Blue (Secondary)",
          "slug": "secondary",
          "color": "#2563EB"
        },
        {
          "name": "Cyan Accent",
          "slug": "accent",
          "color": "#06B6D4"
        },
        {
          "name": "Dark Gold (Brand)",
          "slug": "gold",
          "color": "#C59B27"
        },
        {
          "name": "Champagne Gold",
          "slug": "champagne",
          "color": "#E6C564"
        },
        {
          "name": "Light Background",
          "slug": "light-bg",
          "color": "#F4F7FB"
        },
        {
          "name": "Main Text",
          "slug": "main-text",
          "color": "#172B4D"
        },
        {
          "name": "Secondary Text",
          "slug": "secondary-text",
          "color": "#64748B"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Border Slate",
          "slug": "border-slate",
          "color": "#E2E8F0"
        }
      ],
      "gradients": [
        {
          "name": "Corporate Tech Gradient",
          "slug": "tech-gradient",
          "gradient": "linear-gradient(135deg, #102A43 0%, #1e3a8a 100%)"
        },
        {
          "name": "Dark Gold Luxury Gradient",
          "slug": "gold-gradient",
          "gradient": "linear-gradient(135deg, #E6C564 0%, #C59B27 50%, #94721C 100%)"
        },
        {
          "name": "Subtle Blue Wash",
          "slug": "blue-wash",
          "gradient": "linear-gradient(180deg, #F4F7FB 0%, #FFFFFF 100%)"
        }
      ]
    },
    "layout": {
      "contentSize": "840px",
      "wideSize": "1200px"
    },
    "typography": {
      "fluid": {
        "minViewportWidth": "320px",
        "maxViewportWidth": "1200px"
      },
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Plus Jakarta Sans / Inter",
          "slug": "inter"
        },
        {
          "fontFamily": "'Manrope', system-ui, sans-serif",
          "name": "Manrope",
          "slug": "manrope"
        },
        {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "name": "Monospace",
          "slug": "mono"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small",
          "fluid": {
            "min": "0.8125rem",
            "max": "0.875rem"
          }
        },
        {
          "name": "Medium (Body)",
          "size": "1rem",
          "slug": "medium",
          "fluid": {
            "min": "0.9375rem",
            "max": "1.0625rem"
          }
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.25rem"
          }
        },
        {
          "name": "Extra Large",
          "size": "1.625rem",
          "slug": "x-large",
          "fluid": {
            "min": "1.25rem",
            "max": "1.625rem"
          }
        },
        {
          "name": "Heading 2",
          "size": "2.25rem",
          "slug": "2x-large",
          "fluid": {
            "min": "1.45rem",
            "max": "2.25rem"
          }
        },
        {
          "name": "Display Hero",
          "size": "3rem",
          "slug": "3x-large",
          "fluid": {
            "min": "1.85rem",
            "max": "3rem"
          }
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "padding": true,
      "margin": true,
      "blockGap": true,
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        {
          "name": "1 - Extra Small",
          "size": "clamp(0.375rem, 1vw, 0.5rem)",
          "slug": "20"
        },
        {
          "name": "2 - Small",
          "size": "clamp(0.625rem, 1.5vw, 0.875rem)",
          "slug": "30"
        },
        {
          "name": "3 - Medium",
          "size": "clamp(0.875rem, 2vw, 1.25rem)",
          "slug": "40"
        },
        {
          "name": "4 - Large",
          "size": "clamp(1.25rem, 3vw, 2rem)",
          "slug": "50"
        },
        {
          "name": "5 - Extra Large",
          "size": "clamp(1.75rem, 4vw, 3rem)",
          "slug": "60"
        },
        {
          "name": "6 - Section Padding",
          "size": "clamp(2.25rem, 6vw, 4.5rem)",
          "slug": "70"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--main-text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "clamp(1rem, 2.5vw, 1.75rem)",
      "padding": {
        "top": "0px",
        "bottom": "0px",
        "left": "clamp(0.875rem, 3.5vw, 2rem)",
        "right": "clamp(0.875rem, 3.5vw, 2rem)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3x-large)",
          "lineHeight": "1.18"
        },
        "spacing": {
          "margin": {
            "top": "0.75rem",
            "bottom": "1rem"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2x-large)",
          "lineHeight": "1.25"
        },
        "spacing": {
          "margin": {
            "top": "0.5rem",
            "bottom": "0.875rem"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.3"
        },
        "spacing": {
          "margin": {
            "top": "0.5rem",
            "bottom": "0.75rem"
          }
        }
      },
      "button": {
        "border": {
          "radius": "8px"
        },
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontSize": "clamp(0.875rem, 1.5vw, 1rem)",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "clamp(0.625rem, 1.5vw, 0.75rem)",
            "bottom": "clamp(0.625rem, 1.5vw, 0.75rem)",
            "left": "clamp(1rem, 2.5vw, 1.5rem)",
            "right": "clamp(1rem, 2.5vw, 1.5rem)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-services",
      "title": "Services Directory",
      "postTypes": ["page"]
    },
    {
      "name": "page-solutions",
      "title": "Business Solutions",
      "postTypes": ["page"]
    },
    {
      "name": "page-portfolio",
      "title": "Project Portfolio",
      "postTypes": ["page"]
    },
    {
      "name": "page-contact",
      "title": "Contact & Consultation",
      "postTypes": ["page"]
    }
  ]
}
